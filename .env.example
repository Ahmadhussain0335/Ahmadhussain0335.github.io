# Public URL used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://ahmadhussain.dev

# Formspree form ID (the part after https://formspree.io/f/).
# When unset, the contact form opens a prefilled email instead of submitting.
NEXT_PUBLIC_FORMSPREE_ID=

# Google Search Console HTML-tag verification token (the content="..." value only).
# Not needed when the domain is verified through a DNS TXT record.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cloudflare Web Analytics site token (cookieless). When unset, no analytics script loads.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
